# ==============================================================================
# HOMESTOCK BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and customize values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & PROFILES
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_APPLICATION_NAME=homestock-backend

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & HikariCP Pool)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/homestock
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_DRIVER=org.postgresql.Driver

HIKARI_POOL_NAME=HomeStockHikariPool
HIKARI_MAX_POOL_SIZE=25
HIKARI_MIN_IDLE=10
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=1200000
HIKARI_CONNECTION_TIMEOUT=20000
HIKARI_VALIDATION_TIMEOUT=3000
HIKARI_LEAK_DETECTION_THRESHOLD=30000

# JPA & Hibernate
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
HIBERNATE_BATCH_FETCH_SIZE=50

# Flyway Database Migrations
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
FLYWAY_VALIDATE_ON_MIGRATE=true

# ------------------------------------------------------------------------------
# 3. MULTIPART & FILE UPLOAD
# ------------------------------------------------------------------------------
MULTIPART_MAX_FILE_SIZE=25MB
MULTIPART_MAX_REQUEST_SIZE=25MB

# Storage Provider (local or s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
AWS_S3_BUCKET=homestock-media
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 4. REDIS & DISTRIBUTED CACHE
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms
REDIS_CONNECT_TIMEOUT=2000ms

# Redis Connection Pool (Lettuce)
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=2000ms

# Redis Cache TTLs & Locks
REDIS_CACHE_DASHBOARD_TTL=300
REDIS_CACHE_PRODUCT_TTL=86400
REDIS_CACHE_DEALS_TTL=900
REDIS_LOCK_LEASE_SECONDS=10
REDIS_LOCK_WAIT_SECONDS=5
REDIS_RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 5. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=7776000000

# ------------------------------------------------------------------------------
# 6. GEMINI AI ENGINE (Voice Assistant, Smart Deals, Printed & Handwritten Bills)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Voice Assistant (Homie) Configuration
VOICE_PROVIDER=gemini
VOICE_GEMINI_MODEL=gemini-flash-lite-latest
VOICE_GEMINI_TEMPERATURE=0.1
VOICE_GEMINI_MAX_OUTPUT_TOKENS=2048
VOICE_GEMINI_TIMEOUT_SECONDS=30

# Whisper Cloud Fallback (Optional)
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_TEMPERATURE=0.0

# Voice Processing & Confidence Limits
VOICE_MAX_AUDIO_SIZE_MB=25
VOICE_MAX_AUDIO_DURATION_SECONDS=60
VOICE_CONFIDENCE_THRESHOLD=0.80
VOICE_CONTEXT_TIMEOUT=120
VOICE_IDEMPOTENCY_WINDOW=30
VOICE_AUDIT_RETENTION_DAYS=90
VOICE_AUTO_EXECUTE_THRESHOLD=0.95
VOICE_CONFIRMATION_THRESHOLD=0.80

# ------------------------------------------------------------------------------
# 7. SMART SHOPPING & PRICE COMPARISON ENGINE
# ------------------------------------------------------------------------------
SMART_SHOPPING_ENABLED=true
PRICE_CACHE_TTL_MINUTES=15
MATCH_CONFIDENCE_THRESHOLD=0.75
PROVIDER_TIMEOUT_SECONDS=5

# E-Commerce Providers
MOCK_PROVIDER_ENABLED=false
ONLINE_PROVIDER_ENABLED=true

AMAZON_PROVIDER_ENABLED=true
AMAZON_PARTNER_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

FLIPKART_PROVIDER_ENABLED=true
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ------------------------------------------------------------------------------
# 8. PUSH NOTIFICATIONS & ML DECISION ENGINE
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_STOCK_COOLDOWN_HOURS=24
NOTIFICATION_EXPIRY_COOLDOWN_HOURS=24
NOTIFICATION_RESTOCK_COOLDOWN_HOURS=72

QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

NOTIF_WEIGHT_URGENCY=0.30
NOTIF_WEIGHT_RELEVANCE=0.25
NOTIF_WEIGHT_CONFIDENCE=0.20
NOTIF_WEIGHT_ACTION_PROB=0.15
NOTIF_WEIGHT_FATIGUE=0.10

NOTIF_MAX_PUSH_PER_DAY=5
NOTIF_MAX_NOTIF_PER_HOUR=2
NOTIF_DISMISSAL_THRESHOLD=3
NOTIF_GROUPING_MIN_ITEMS=3

ML_NOTIFICATION_SCHEDULER_ENABLED=true
ML_NOTIFICATION_CRON=0 0 */4 * * *

# ------------------------------------------------------------------------------
# 9. HOUSEHOLD INTELLIGENCE ("While You Were Away")
# ------------------------------------------------------------------------------
AWAY_SUMMARY_ENABLED=true
AWAY_MIN_INACTIVE_DAYS=3
AWAY_CONFIDENCE_THRESHOLD=0.40
AWAY_MAX_SUMMARY_ITEMS=5

# ------------------------------------------------------------------------------
# 10. ACTUATOR, MONITORING & METRICS
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINTS_BASE_PATH=/actuator

# ------------------------------------------------------------------------------
# 11. OPENAPI / SWAGGER DOCUMENTATION
# ------------------------------------------------------------------------------
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_OPERATIONS_SORTER=method

# ------------------------------------------------------------------------------
# 12. LOGGING LEVELS
# ------------------------------------------------------------------------------
LOGGING_LEVEL_HOMESTOCK=DEBUG
LOGGING_LEVEL_SECURITY=INFO
